SELECT TOP 100
    j.name AS JobName,
    h.step_name,
    msdb.dbo.agent_datetime(h.run_date, h.run_time) AS ExecutionDate,
    h.run_status,
    h.sql_message_id,
    h.message
FROM msdb.dbo.sysjobhistory h
INNER JOIN msdb.dbo.sysjobs j
    ON h.job_id = j.job_id
WHERE
    h.step_id <> 0
    AND msdb.dbo.agent_datetime(h.run_date, h.run_time)
        >= DATEADD(HOUR, -24, GETDATE())
    AND (
        h.message LIKE '%ACE.OLEDB%'
        OR h.message LIKE '%7303%'
        OR h.message LIKE '%7339%'
    )
ORDER BY ExecutionDate DESC;






